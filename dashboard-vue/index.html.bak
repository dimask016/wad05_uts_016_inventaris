<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b4f6c" />
    <meta name="description" content="Dashboard Inventaris — UTS WAD05. Mini full-stack app dengan Vue 3 + FastAPI." />
    <meta name="author" content="Nama Anda — NIM 25120300016" />

    <!-- Favicon SVG inline (tidak butuh file eksternal) -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230b4f6c'/%3E%3Cpath d='M25 35 L50 22 L75 35 L75 65 L50 78 L25 65 Z' fill='none' stroke='white' stroke-width='6' stroke-linejoin='round'/%3E%3Cpath d='M25 35 L50 48 L75 35 M50 48 L50 78' fill='none' stroke='white' stroke-width='6' stroke-linejoin='round'/%3E%3C/svg%3E"
    />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Splash screen CSS (file terpisah di public/splash.css) -->
    <link rel="stylesheet" href="/splash.css" />

    <title>Dashboard Inventaris — UTS WAD05</title>
  </head>

  <body>
    <!-- Splash screen (hilang setelah Vue mount) -->
    <div id="splash">
      <svg class="splash-logo" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="100" height="100" rx="20" fill="rgba(255,255,255,0.1)" />
        <path
          d="M25 35 L50 22 L75 35 L75 65 L50 78 L25 65 Z"
          stroke="#ffffff"
          stroke-width="6"
          stroke-linejoin="round"
        />
        <path
          d="M25 35 L50 48 L75 35 M50 48 L50 78"
          stroke="#ffffff"
          stroke-width="6"
          stroke-linejoin="round"
        />
      </svg>
      <div class="splash-title">Dashboard Inventaris</div>
      <div class="splash-subtitle">Memuat aplikasi...</div>
      <div class="splash-spinner"></div>
    </div>

    <!-- Vue mounts di sini -->
    <div id="app"></div>

    <noscript>
      <div class="noscript-warning">
        JavaScript wajib diaktifkan untuk menjalankan aplikasi ini.
      </div>
    </noscript>

    <script type="module" src="/src/main.js"></script>
  </body>
</html>
