<script setup>
defineProps({
  barang: { type: Object, required: true },
  status: { type: Object, required: true }, // { kelas, label }
});

defineEmits(["hapus", "edit"]);
</script>

<template>
  <div class="kartu">
    <div class="kartu-nama">{{ barang.nama }}</div>
